generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN
  BRANCH_MANAGER
  CASHIER
}

enum PaymentMethod {
  CASH
  YAPE
  PLIN
  CARD
  TRANSFER
}

enum SaleStatus {
  COMPLETED
  CANCELLED
}

enum TransferStatus {
  COMPLETED
  PENDING
  CANCELLED
}

enum DocumentType {
  FACTURA
  BOLETA
  NOTA_VENTA
}

enum SunatStatus {
  ACEPTADO
  PENDIENTE
  RECHAZADO
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum MovementType {
  INGRESO
  EGRESO
}

enum KardexType {
  VENTA
  COMPRA
  TRANSFERENCIA_ENTRADA
  TRANSFERENCIA_SALIDA
  AJUSTE
  MERMA
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(CASHIER)
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales          Sale[]
  transfers      StockTransfer[]
  cashRegisters  CashRegister[]
}

model Branch {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  address   String
  phone     String?
  isMain    Boolean  @default(false)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  stocks           BranchStock[]
  sales            Sale[]
  transfersOrigin  StockTransfer[]  @relation("OriginBranch")
  transfersDest    StockTransfer[]  @relation("DestinationBranch")
  cashRegisters    CashRegister[]
  kardexMovements  KardexMovement[]
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  products    Product[]
}

model Product {
  id             String        @id @default(uuid())
  sku            String        @unique
  barcode        String?       @unique
  name           String
  description    String?
  price          Float
  costPrice      Float         @default(0.0)
  categoryId     String
  category       Category      @relation(fields: [categoryId], references: [id])
  minStockAlert  Int           @default(5)
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  branchStocks    BranchStock[]
  saleItems       SaleItem[]
  transferItems   TransferItem[]
  kardexMovements KardexMovement[]
}

model BranchStock {
  id             String   @id @default(uuid())
  branchId       String
  productId      String
  quantity       Int      @default(0)
  minStockAlert  Int      @default(5)
  updatedAt      DateTime @updatedAt

  branch         Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([branchId, productId])
}

model Sale {
  id               String        @id @default(uuid())
  saleNumber       String        @unique
  documentType     DocumentType  @default(BOLETA)
  series           String        @default("B001")
  correlative      Int           @default(1)
  branchId         String
  branch           Branch        @relation(fields: [branchId], references: [id])
  userId           String
  user             User          @relation(fields: [userId], references: [id])
  customerName     String        @default("Clientes Varios")
  customerDoc      String?       // DNI (8 digitos) o RUC (11 digitos)
  customerEmail    String?
  customerAddress  String?
  customerPhone    String?
  paymentMethod    PaymentMethod @default(CASH)
  operationCode    String?       // Código de confirmación de Yape/Plin o voucher
  amountPaid       Float?        // Monto con el que paga el cliente
  changeAmount     Float?        // Vuelto en soles entregado al cliente
  currency         String        @default("PEN") // PEN (S/) o USD ($)
  subtotal         Float
  tax              Float         @default(0.0) // 18% IGV en Perú
  total            Float
  hash             String?       // Código Hash SHA-256 SUNAT
  qrString         String?       // Contenido oficial del QR tributario SUNAT
  sunatStatus      SunatStatus   @default(ACEPTADO)
  status           SaleStatus    @default(COMPLETED)
  notes            String?
  createdAt        DateTime      @default(now())

  cashRegisterId   String?
  cashRegister     CashRegister? @relation(fields: [cashRegisterId], references: [id])

  items            SaleItem[]
}

model SaleItem {
  id        String   @id @default(uuid())
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Float
  subtotal  Float
}

model StockTransfer {
  id             String         @id @default(uuid())
  transferNumber String         @unique
  fromBranchId   String
  fromBranch     Branch         @relation("OriginBranch", fields: [fromBranchId], references: [id])
  toBranchId     String
  toBranch       Branch         @relation("DestinationBranch", fields: [toBranchId], references: [id])
  userId         String
  user           User           @relation(fields: [userId], references: [id])
  notes          String?
  status         TransferStatus @default(COMPLETED)
  createdAt      DateTime       @default(now())

  items          TransferItem[]
}

model TransferItem {
  id         String        @id @default(uuid())
  transferId String
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId  String
  product    Product       @relation(fields: [productId], references: [id])
  quantity   Int
}

model CashRegister {
  id                  String       @id @default(uuid())
  branchId            String
  branch              Branch       @relation(fields: [branchId], references: [id])
  userId              String
  user                User         @relation(fields: [userId], references: [id])
  initialAmount       Float        @default(0.0)
  finalAmount         Float?       // Efectivo real contado en gaveta
  cashSalesAmount     Float        @default(0.0)
  yapeSalesAmount     Float        @default(0.0)
  plinSalesAmount     Float        @default(0.0)
  cardSalesAmount     Float        @default(0.0)
  transferSalesAmount Float        @default(0.0)
  totalIncomes        Float        @default(0.0)
  totalExpenses       Float        @default(0.0)
  expectedAmount      Float?       // Efectivo esperado = inicial + ventasEfectivo + ingresos - egresos
  differenceAmount    Float?       // Sobrante (+), Faltante (-) o Conforme (0)
  status              ShiftStatus  @default(OPEN)
  notes               String?
  openedAt            DateTime     @default(now())
  closedAt            DateTime?

  sales               Sale[]
  movements           CashMovement[]
}

model CashMovement {
  id             String       @id @default(uuid())
  cashRegisterId String
  cashRegister   CashRegister @relation(fields: [cashRegisterId], references: [id], onDelete: Cascade)
  type           MovementType
  amount         Float
  concept        String
  createdAt      DateTime     @default(now())
}

model KardexMovement {
  id            String     @id @default(uuid())
  branchId      String
  branch        Branch     @relation(fields: [branchId], references: [id])
  productId     String
  product       Product    @relation(fields: [productId], references: [id])
  type          KardexType
  quantity      Int
  previousStock Int
  newStock      Int
  reference     String?
  createdAt     DateTime   @default(now())
}
