{
  "name": "inventory-billing-server",
  "version": "1.0.0",
  "description": "API REST y motor transaccional multi-sucursal para Inventory Billing SaaS",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && prisma generate",
